{
  "name": "@acme/extension",
  "description": "NSDA Debate Card Cutter - Browser Extension",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox --mv3",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox --mv3",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox --mv3",
    "test:manifest": "pnpm build && pnpm build:firefox && node scripts/assert-manifests.mjs",
    "check": "wxt prepare && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run src",
    "test:e2e": "playwright test",
    "test:firefox:smoke": "python3 scripts/firefox-smoke.py",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
	"@acme/shared": "workspace:*",
	"lucide-svelte": "^0.545.0",
    "ztractor": "file:../../../ztractor/packages/core"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.17",
    "@playwright/test": "1.63.0",
    "@tsconfig/svelte": "^5.0.5",
    "@wxt-dev/module-svelte": "^2.0.3",
    "svelte": "^5.38.6",
    "svelte-check": "^4.3.1",
    "tailwindcss": "^4.1.17",
    "tslib": "^2.8.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "wxt": "^0.20.6"
  }
}
